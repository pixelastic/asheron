SALAI_TOKEN=

# ID de votre serveur Discord
# Pour l'obtenir: Cliquez sur un channel dans Discord et regardez l'URL
# Format: https://discord.com/channels/SERVER_ID/CHANNEL_ID
SERVER_ID=

# ID de votre channel Discord (celui où le bot Midjourney est présent)
CHANNEL_ID=
